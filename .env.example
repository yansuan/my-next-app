# ============================================================================
# ReelMux (https://reelmux.com) Environment Configuration
# Deploy Stack: Vercel + Cloudflare (DNS/CDN/R2) + Supabase + Yir.ai API
# ============================================================================

# 1. Site & Brand Metadata
NEXT_PUBLIC_SITE_URL=https://reelmux.com
NEXT_PUBLIC_SITE_NAME=ReelMux

# 2. Yir.ai Multimodal API Router (https://yir.ai)
YIR_API_BASE_URL=https://gateway.yir.ai/v1
YIR_API_KEY=yir_live_your_api_key_here

# 3. Supabase (Auth + Postgres + Atomic Credit Ledger)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4. Cloudflare R2 Object Storage (Reference Uploads & Media Persistence)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=reelmux-media
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.reelmux.com

# 5. Stripe / MoR Billing (Optional for Credit Packs & Subscriptions)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
